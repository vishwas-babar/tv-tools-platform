generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
}

enum SubscriptionStatus {
  PENDING_ACCESS
  ACTIVE
}

enum AutopayStatus {
  INITIALIZED
  BANK_APPROVAL_PENDING
  ACTIVE
  ON_HOLD
  PAUSED
  COMPLETED
  CUSTOMER_CANCELLED
  CUSTOMER_PAUSED
  EXPIRED
  LINK_EXPIRED
  CARD_EXPIRED
  CANCELLED
}

model User {
  id            String         @id @default(cuid())
  name          String
  email         String         @unique
  password      String
  phone         String
  tradingViewId String?
  role          Role           @default(USER)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  subscriptions Subscription[]
  payments      Payment[]
  orders        Order[]
}

model Tool {
  id            String         @id @default(cuid())
  name          String
  slug          String         @unique
  description   String
  imageUrl      String?
  youtubeUrl    String?
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  plans         Plan[]
  subscriptions Subscription[]
  orderItems    OrderItem[]
}

model Plan {
  id            String         @id @default(cuid())
  name          String
  durationDays  Int
  price         Float
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  tools         Tool[]
  subscriptions Subscription[]
  orderItems    OrderItem[]
}

model Subscription {
  id                     String             @id @default(cuid())
  userId                 String
  toolId                 String
  planId                 String
  orderId                String?
  status                 SubscriptionStatus @default(PENDING_ACCESS)
  startDate              DateTime?
  endDate                DateTime?
  cashfreeSubscriptionId String?            @unique
  cfSubscriptionId       String?            @unique
  recurringAmount        Float?
  firstChargeAmount      Float?
  autopayStatus          AutopayStatus?
  nextBillingDate        DateTime?
  autopayEnabled         Boolean            @default(true)
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  user                   User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  tool                   Tool               @relation(fields: [toolId], references: [id], onDelete: Cascade)
  plan                   Plan               @relation(fields: [planId], references: [id], onDelete: Cascade)
  order                  Order?             @relation(fields: [orderId], references: [id])
  renewalPayments        RenewalPayment[]
}

model Coupon {
  id            String       @id @default(cuid())
  code          String       @unique
  discountType  DiscountType
  discountValue Float
  active        Boolean      @default(true)
  usedAt        DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  orders        Order[]
}

model Order {
  id               String      @id @default(cuid())
  userId           String
  subtotalAmount   Float?
  discountAmount   Float?
  couponId         String?
  couponCode       String?
  totalAmount      Float
  status           OrderStatus @default(PENDING)
  cashfreeOrderId  String      @unique
  paymentSessionId String?
  autopaySessions  Json?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  coupon           Coupon?     @relation(fields: [couponId], references: [id], onDelete: SetNull)
  items            OrderItem[]
  payment          Payment?
  subscriptions    Subscription[]
}

model RenewalPayment {
  id                String       @id @default(cuid())
  subscriptionId    String
  amount            Float
  status            String
  providerPaymentId String?
  billingPeriodStart DateTime?
  billingPeriodEnd   DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  subscription      Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
}

model OrderItem {
  id      String @id @default(cuid())
  orderId String
  toolId  String
  planId  String
  price   Float
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  tool    Tool   @relation(fields: [toolId], references: [id])
  plan    Plan   @relation(fields: [planId], references: [id])
}

model Payment {
  id                String   @id @default(cuid())
  userId            String
  amount            Float
  status            String
  paymentProvider   String?
  providerPaymentId String?
  orderId           String?  @unique
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  order             Order?   @relation(fields: [orderId], references: [id])
}
